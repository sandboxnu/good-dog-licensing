{
  "name": "@good-dog/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "browser": "./src/enums.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": " prisma format && prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "push": "prisma db push",
    "studio": "prisma studio",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:create": "prisma migrate dev --create-only",
    "reset:no-seed": "prisma migrate reset",
    "reset:seed": "prisma migrate reset && prisma db seed"
  },
  "dependencies": {
    "@good-dog/env": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@good-dog/eslint": "workspace:*",
    "@good-dog/prettier": "workspace:*",
    "@good-dog/typescript": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "typescript": "6.0.3"
  }
}
